# 用法：复制本文件为 .env，然后把下面的值换成你自己的
#   Copy-Item .env.example .env
# 生成一个新密钥：
#   python -c "from django.core.management.utils import get_random_secret_key as g; print('DJANGO_SECRET_KEY=' + g())"
DJANGO_SECRET_KEY=replace-with-your-own-key

# 允许访问的域名，逗号分隔。开头带点的表示通配子域。
# 本地开发不用动；部署到服务器时把正式域名加进来。
# DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,.trycloudflare.com,example.com
